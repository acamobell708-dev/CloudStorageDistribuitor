AZURE_GIT_REMOTE=https://your-organization@dev.azure.com/your-organization/your-project/_git/your-repository
AZURE_GIT_BRANCH=main
AZURE_GIT_PUSH=false
# Use "pat" locally or "managed-identity" in Azure.
AZURE_AUTH_MODE=pat
AZURE_DEVOPS_PAT=
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_PURGE_AUTH_MODE=pat
AZURE_PURGE_PAT=
AZURE_PURGE_MANAGED_IDENTITY_CLIENT_ID=
GIT_IPV4_ONLY=false

# CLI connectivity tests only; the web application does not receive this path.
AZURE_DATA_REPO_DIR=../AzureDataRepo
GIT_SSL_BACKEND=
HOST=127.0.0.1
PORT=3000
AUTH_SESSION_HOURS=8
AUTH_SECURE_COOKIE=false
UPLOAD_TEMP_DIR=

# Box Client Credentials Grant
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_FOLDER_ID=
BOX_MAX_UPLOAD_SIZE_MB=250
BOX_DOWNLOAD_DIR=./.box-downloads
