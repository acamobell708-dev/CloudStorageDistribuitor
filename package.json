{
  "name": "cloud-storage-distributor",
  "version": "0.1.0",
  "private": true,
  "description": "A React and Node.js workspace for sending files to connected cloud storage providers.",
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "check:syntax": "node src/scripts/checkSyntax.js",
    "dev": "node src/dev.js",
    "dev:client": "vite --config vite.config.mjs",
    "dev:server": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:connectivity": "node PlatformConnectivityTests/RunAll.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "express": "^5.2.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.1.5"
  }
}
